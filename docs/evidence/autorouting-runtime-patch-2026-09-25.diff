+import tempfile
+import unittest
+from pathlib import Path
+
+from router.router import ModelRouter
+
+
+ROOT = Path(__file__).resolve().parents[1]
+POLICY = ROOT / "router" / "models.json"
+
+
+class IntentCalibrationTests(unittest.TestCase):
+    def classify(self, task: str):
+        with tempfile.TemporaryDirectory() as td:
+            project = Path(td)
+            (project / ".agent").mkdir()
+            (project / "TASK.md").write_text(task, encoding="utf-8")
+            (project / "CONTEXT.md").write_text("", encoding="utf-8")
+            (project / ".agent" / "CHECKPOINT.md").write_text("", encoding="utf-8")
+            state = {
+                "runtime": {"consecutive_failures": 0, "same_error_count": 0},
+                "routing": {"capabilities": {"gpt-6-astra": False}},
+            }
+            return ModelRouter(
+                project=project,
+                cfg={"routing": {"mode": "shadow"}},
+                state=state,
+                policy_path=POLICY,
+            ).decide()
+
+    def test_safe_and_protected_intent_pairs_keep_c4_floor_without_false_positives(self):
+        pairs = [
+            (
+                "Create local JSON. Do not touch SSH, OAuth, or services.",
+                "Connect by SSH and restart the production service.",
+            ),
+            (
+                "Write rollback documentation; do not apply policy.",
+                "Apply policy on the production VPS.",
+            ),
+            (
+                "Update a mock OAuth fixture.",
+                "Rotate a real OAuth credential.",
+            ),
+            (
+                "Unit-test session deletion with a temporary database.",
+                "Delete real runtime sessions.",
+            ),
+            (
+                "Restart a local development service.",
+                "Restart the production service.",
+            ),
+        ]
+        for safe, protected in pairs:
+            with self.subTest(safe=safe):
+                safe_result = self.classify(safe)
+                protected_result = self.classify(protected)
+                self.assertLessEqual(int(safe_result.recommended_tier[1:]), 2)
+                self.assertGreaterEqual(int(protected_result.recommended_tier[1:]), 4)
+
+    def test_mixed_and_double_negation_preserve_real_protected_actions(self):
+        protected_tasks = [
+            "Never restart staging, but deploy production.",
+            "Do not skip deploying production.",
+            "Deploy production without downtime.",
+            "Deploy without downtime to production.",
+            "Update a mock dashboard by rotating a real OAuth credential.",
+        ]
+        for task in protected_tasks:
+            with self.subTest(task=task):
+                result = self.classify(task)
+                self.assertGreaterEqual(int(result.recommended_tier[1:]), 4)
+
+
+if __name__ == "__main__":
+    unittest.main()
