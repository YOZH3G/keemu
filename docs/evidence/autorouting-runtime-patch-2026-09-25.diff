+def _actionable_clauses(text: str) -> tuple[list[str], list[str]]:
+    """Return positive action clauses and their risk-bearing subset."""
+    clauses: list[str] = []
+    in_constraint_section = False
+    for raw_line in text.splitlines() or [text]:
+        line = raw_line.strip()
+        heading = re.match(r"^#{1,6}\s+(.*)$", line)
+        if heading:
+            in_constraint_section = bool(_CONSTRAINT_HEADING.search(heading.group(1)))
+            continue
+        line = re.sub(r"^[-*+]\s+(?:\[[ xX]\]\s*)?", "", line)
+        if not line:
+            continue
+        parts = re.split(r"\s*(?:[.;]|\s+[—–-]\s+|\bbut\b|\bwhile\b|\bthen\b)\s*", line, flags=re.I)
+        for part in parts:
+            clause = part.strip(" ,:")
+            if not clause or not _ACTION.search(clause):
+                continue
+            negated = bool(_NEGATION.search(clause)) and not bool(_DOUBLE_NEGATION.search(clause))
+            if negated:
+                continue
+            # Constraint sections still contribute affirmative requirements, but
+            # pure safety mentions without an action have already been removed.
+            if in_constraint_section or not in_constraint_section:
+                clauses.append(clause)
+    risk_clauses = [
+        clause for clause in clauses
+        if not _SAFE_OBJECT.search(clause) or _REAL_PROTECTED_OBJECT.search(clause)
+    ]
+    return clauses, risk_clauses
