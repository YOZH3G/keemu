{
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "cause_class": {
          "enum": [
            "package",
            "environment",
            "harness",
            "unknown"
          ],
          "title": "Cause Class",
          "type": "string"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "mode": {
          "enum": [
            "real",
            "shim",
            "static"
          ],
          "title": "Mode",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "SKIP",
            "BLOCKED",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "cause_class",
        "evidence",
        "mode",
        "required",
        "duration_seconds",
        "limitations"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "minimum": 0,
          "title": "Blocked",
          "type": "integer"
        },
        "errors": {
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "required": {
          "minimum": 0,
          "title": "Required",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "warned": {
          "minimum": 0,
          "title": "Warned",
          "type": "integer"
        }
      },
      "required": [
        "required",
        "passed",
        "failed",
        "blocked",
        "skipped",
        "warned",
        "errors"
      ],
      "title": "Coverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "overall": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "SKIP",
        "BLOCKED",
        "ERROR"
      ],
      "title": "Overall",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "operation",
    "profile_id",
    "overall",
    "coverage",
    "checks",
    "limitations"
  ],
  "title": "RunReport",
  "type": "object"
}
