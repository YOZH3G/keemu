      "minLength": 1,
      "title": "Qemu Version",
      "type": "string"
    },
    "feed_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feed Lock Sha256",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceLock"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "scenario_id",
    "scenario_sha256",
    "profile_id",
    "profile_revision",
    "profile_sha256",
    "entware_target",
    "oci_digest",
    "qemu_version",
    "feed_lock_sha256",
    "sources"
  ],
  "title": "ScenarioLock",
  "type": "object"
